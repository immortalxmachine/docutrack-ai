# ===========================================================================
# DocuTrack AI — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# MUST NOT be committed. Every setting below has a safe default in config.py,
# so the app still boots even if a value is missing.
# ===========================================================================

# ---- LLM provider: "gemini" | "ollama" | "mock" --------------------------
# "mock" returns a canned, deterministic answer and needs no key — it is what
# the automated tests use so CI never calls a real LLM.
LLM_PROVIDER=gemini

# Google Gemini (free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama (alternative, no API key): https://ollama.com
# Run `ollama pull llama3.1` first, then set LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Embeddings (runs locally, no key) -----------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Retrieval tuning ----------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
# Minimum cosine similarity for the top hit; below this, /ask says "I don't know".
MIN_CONFIDENCE=0.30

# ---- Database (invoice storage) ------------------------------------------
# PostgreSQL in production / docker-compose. For a quick local run with no
# Postgres, use SQLite:  sqlite:///./data/docutrack.db
DATABASE_URL=postgresql+psycopg://docutrack:docutrack@localhost:5432/docutrack

# ---- Paths ---------------------------------------------------------------
DOCS_DIR=data/docs
INDEX_DIR=data/index

# ---- API base URL the Streamlit UI calls ---------------------------------
API_BASE_URL=http://localhost:8000
